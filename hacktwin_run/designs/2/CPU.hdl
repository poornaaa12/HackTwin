// Design Variant 2: Refactored Hack CPU implementation with Fast-Path Jump Evaluator
// File name: projects/05/CPU.hdl
// Hack CPU Architecture Variant 2 (Micro-architectural Refactoring for HackTwin Phase 8)

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current program

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // Address of next instruction

    PARTS:
    /** Instruction Decoding Unit **/
    DMux(in=true, sel=instruction[15], a=atype, b=ctype);
    Or(a=atype, b=instruction[5], out=ainstruct);
    And(a=ctype, b=instruction[4], out=cinstruct);

    /** A Register & Memory Address Bus **/
    Mux16(a=aluout, b=instruction, sel=atype, out=toareg);
    ARegister(in=toareg, load=ainstruct, out=aregout, out[0..14]=addressM);

    /** D Register & ALU Source Selection **/
    Mux16(a=aregout, b=inM, sel=instruction[12], out=inputsel);

    ALU(x=dregout, y=inputsel, zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8], 
        f=instruction[7], no=instruction[6], out=aluout, zr=zrout, ng=ngout, out=outM);
    And(a=ctype, b=instruction[3], out=writeM);

    DRegister(in=aluout, load=cinstruct, out=dregout);

    /** Fast-Path Jump Evaluator (Variant 2 Micro-architectural Optimization)
      * Parallelized branch condition evaluation reducing gate delay:
      * Evaluates JGT, JEQ, JLT conditions directly from ALU flags. **/
    Not(in=zrout, out=notzr);
    Not(in=ngout, out=notng);
    And(a=notzr, b=notng, out=posout);          // out > 0

    And(a=instruction[0], b=posout, out=jgt);   // JGT (out > 0)
    And(a=instruction[1], b=zrout, out=jeq);   // JEQ (out == 0)
    And(a=instruction[2], b=ngout, out=jlt);   // JLT (out < 0)

    Or(a=jgt, b=jeq, out=jge);
    Or(a=jge, b=jlt, out=jmp);

    And(a=jmp, b=ctype, out=dojump);
    Not(in=dojump, out=nojump);
    PC(in=aregout, load=dojump, inc=nojump, reset=reset, out[0..14]=pc);
}
